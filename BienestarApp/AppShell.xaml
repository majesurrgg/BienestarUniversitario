<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BienestarApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BienestarApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="BienestarApp">

    <!-- La app arranca en Login (primer ShellContent). LoginPage y MainPage
         son raíces de Shell para poder saltar entre ellas con rutas
         absolutas ("//MainPage", "//LoginPage") y que el botón "atrás" no
         regrese al login tras iniciar sesión. Con el flyout deshabilitado
         y cada una en su propio ShellContent, Shell no dibuja tabs.
         RegisterPage sí es una ruta registrada en AppShell.xaml.cs porque
         se apila encima de Login (se vuelve con ".."). -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />

</Shell>
