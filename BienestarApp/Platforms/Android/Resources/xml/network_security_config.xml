<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9+ bloquea HTTP sin cifrar por defecto. Se permite solo hacia
     la PC de desarrollo (emulador: 10.0.2.2, celular por USB con
     adb reverse: localhost; celular en la zona móvil de la PC:
     192.168.137.1); cualquier otro host sigue exigiendo HTTPS. -->
<network-security-config>
	<domain-config cleartextTrafficPermitted="true">
		<domain includeSubdomains="false">10.0.2.2</domain>
		<domain includeSubdomains="false">192.168.137.1</domain>
		<domain includeSubdomains="false">localhost</domain>
		<domain includeSubdomains="false">127.0.0.1</domain>
	</domain-config>
</network-security-config>
