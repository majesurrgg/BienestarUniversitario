<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             x:Class="BienestarApp.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}">

    <Grid>
        <!-- Imagen de fondo (no color plano): formas suaves en la paleta de
             la app, concentradas en las esquinas para que el centro (logo y
             campos) quede siempre legible. Solo en Login, es la primera
             pantalla que ve cualquiera. -->
        <Image Source="fondo_login.svg" Aspect="AspectFill" IsVisible="{AppThemeBinding Light=True, Dark=False}" />

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="18" VerticalOptions="Center">

                <Image Source="logo_bienestar.svg" HeightRequest="84" WidthRequest="84" HorizontalOptions="Center" Margin="0,0,0,8" />
                <Label Text="Bienestar Universitario" Style="{StaticResource Headline}" HorizontalOptions="Center" />
                <Label Text="Inicia sesión para continuar" Style="{StaticResource SubHeadline}" HorizontalOptions="Center" Margin="0,0,0,8" />

                <Border Style="{StaticResource CampoTarjeta}">
                    <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
                </Border>
                <Border Style="{StaticResource CampoTarjeta}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Placeholder="Contraseña" IsPassword="{Binding OcultarPassword}" Text="{Binding Password}" />
                        <Button Grid.Column="1" Text="{Binding IconoOjo}" Command="{Binding AlternarPasswordCommand}"
                                BackgroundColor="Transparent" FontSize="20" Padding="8,0" WidthRequest="48"
                                SemanticProperties.Description="Mostrar u ocultar la contraseña" />
                    </Grid>
                </Border>

                <Label Text="{Binding MensajeError}"
                       TextColor="Red"
                       IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

                <Button Text="Ingresar" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <Button Text="Crear una cuenta" Command="{Binding IrARegistroCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
