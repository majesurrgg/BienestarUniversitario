<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             x:Class="BienestarApp.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <!-- Fondo: foto del árbol (Resources/Raw/fondo_login.jpg) a pantalla
         completa, con una capa oscura encima para que el formulario se lea
         bien. El formulario va en una tarjeta con el color de fondo del tema
         (claro u oscuro), así los campos y textos no dependen de la foto. -->
    <Grid>
        <!-- Degradado turquesa de respaldo: si la foto no cargara, la
             pantalla igual se ve bien (y no gris). -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource Primary}" Offset="0" />
                <GradientStop Color="#0F3E3B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- La foto se carga en LoginPage.xaml.cs desde Resources/Raw. -->
        <Image x:Name="FondoImagen" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <BoxView Color="Black" Opacity="0.35" />

        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

                <VerticalStackLayout Spacing="6" Margin="0,24,0,0">
                    <Image Source="logo_bienestar.svg" HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" />
                    <Label Text="Bienestar Universitario" Style="{StaticResource Headline}" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Un minuto al día para ti" FontSize="15" TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="22,24"
                        BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#E61F1F1F}">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Inicia sesión para continuar" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />

                        <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Placeholder="Contraseña" IsPassword="{Binding OcultarPassword}" Text="{Binding Password}" />
                            <Button Grid.Column="1" Text="{Binding IconoOjo}" Command="{Binding AlternarPasswordCommand}"
                                    BackgroundColor="Transparent" FontSize="20" Padding="8,0" WidthRequest="48"
                                    SemanticProperties.Description="Mostrar u ocultar la contraseña" />
                        </Grid>

                        <Label Text="{Binding MensajeError}"
                               TextColor="Red"
                               IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

                        <Button Text="Ingresar" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                        <Button Text="Crear una cuenta" Command="{Binding IrARegistroCommand}" BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
