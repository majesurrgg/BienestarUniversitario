<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             x:Class="BienestarApp.Views.RegisterPage"
             x:DataType="viewmodels:RegisterViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource FondoSuaveClaro}, Dark={StaticResource FondoSuaveOscuro}}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="14">

            <Label Text="Crear cuenta" Style="{StaticResource Headline}" Margin="0,0,0,6" />

            <Border Style="{StaticResource CampoTarjeta}">
                <Entry Placeholder="Nombre completo" Text="{Binding Nombre}" />
            </Border>
            <Border Style="{StaticResource CampoTarjeta}">
                <Entry Placeholder="Código universitario" Text="{Binding CodigoUniversitario}" />
            </Border>
            <Border Style="{StaticResource CampoTarjeta}">
                <Entry Placeholder="Carrera" Text="{Binding Carrera}" />
            </Border>
            <Border Style="{StaticResource CampoTarjeta}">
                <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
            </Border>
            <Border Style="{StaticResource CampoTarjeta}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Placeholder="Contraseña (mínimo 8 caracteres)" IsPassword="{Binding OcultarPassword}" Text="{Binding Password}" />
                    <Button Grid.Column="1" Text="{Binding IconoOjo}" Command="{Binding AlternarPasswordCommand}"
                            BackgroundColor="Transparent" FontSize="20" Padding="8,0" WidthRequest="48"
                            SemanticProperties.Description="Mostrar u ocultar la contraseña" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CampoTarjeta}">
                <Entry Placeholder="Código de invitación" Text="{Binding CodigoInvitacion}" />
            </Border>

            <!-- Consentimiento informado: obligatorio (Ley 29733, datos de salud).
                 La API también lo exige y guarda cuándo y qué versión se aceptó. -->
            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Primary}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Antes de participar, lee el consentimiento informado: qué datos se recogen, cómo se protegen y que puedes retirarte cuando quieras."
                           FontSize="13" />
                    <Button Text="Leer consentimiento informado"
                            Command="{Binding VerConsentimientoCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            HorizontalOptions="Start"
                            Padding="0" />
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox IsChecked="{Binding AceptaConsentimiento}" Color="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Text="Soy mayor de 18 años, leí el consentimiento y acepto participar"
                               FontSize="13"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"
                               MaximumWidthRequest="240" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding MensajeError}"
                   TextColor="Red"
                   IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Registrarme" Command="{Binding RegistrarCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Volver" Command="{Binding VolverCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
