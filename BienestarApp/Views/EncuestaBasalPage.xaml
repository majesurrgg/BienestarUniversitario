<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             xmlns:items="clr-namespace:BienestarApp.ViewModels.Items"
             x:Class="BienestarApp.Views.EncuestaBasalPage"
             x:DataType="viewmodels:EncuestaBasalViewModel"
             Title="{Binding Title}">

    <Grid Padding="24" RowSpacing="16" RowDefinitions="Auto,*,Auto">

        <!-- ===================== Cargando ===================== -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="3" IsRunning="{Binding CargandoEstado}" IsVisible="{Binding CargandoEstado}" VerticalOptions="Center" />

        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3" Spacing="16" IsVisible="{Binding AccesoBloqueado}">
            <Label Text="✔" FontSize="48" HorizontalOptions="Center" />
            <Label Text="{Binding MensajeBloqueo}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="Volver" Command="{Binding VolverCommand}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3" Spacing="12" IsVisible="{Binding Enviado}">
            <Label Text="✔ Encuesta enviada" Style="{StaticResource SubHeadline}" HorizontalOptions="Center" />
            <Label Text="Gracias por completarla." HorizontalOptions="Center" />
            <Button Text="Volver" Command="{Binding VolverCommand}" />
        </VerticalStackLayout>

        <!-- ===================== Asistente por pasos ===================== -->
        <VerticalStackLayout Grid.Row="0" Spacing="8"
                             IsVisible="{Binding MostrarAsistente}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding TextoPaso}" FontAttributes="Bold" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding FaseActualTexto}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
            </Grid>
            <!-- Barra de progreso propia: el ProgressBar nativo de Android
                 se ve como un rectángulo grueso sin redondear. Esto es un
                 "riel" gris de fondo con una barra turquesa encima que se
                 escala desde la izquierda según el paso (0 a 1). -->
            <Grid HeightRequest="8">
                <BoxView Color="{AppThemeBinding Light=#D8D5CB, Dark=#33383A}" CornerRadius="4"
                         HorizontalOptions="Fill" VerticalOptions="Fill" />
                <BoxView Color="{StaticResource Primary}" CornerRadius="4"
                         HorizontalOptions="Fill" VerticalOptions="Fill"
                         AnchorX="0" ScaleX="{Binding Progreso}" />
            </Grid>
            <Label x:Name="IconoTextoLabel" Text="{Binding IconoPaso}" FontSize="40" HorizontalOptions="Center" />
            <Label Text="{Binding TituloPaso}" Style="{StaticResource SubHeadline}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" IsVisible="{Binding MostrarAsistente}">
            <VerticalStackLayout Spacing="16">

                <Label Text="{Binding MensajeError}"
                       TextColor="Red"
                       IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

                <!-- ===================== Paso 1: PHQ-9 ===================== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding EnPasoPhq9}">
                    <Label Text="Durante las últimas 2 semanas, ¿con qué frecuencia te ha molestado cada uno de los siguientes problemas?" />
                    <CollectionView ItemsSource="{Binding PreguntasPhq9}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="items:PreguntaPhq9Item">
                                <VerticalStackLayout Spacing="4" Margin="0,8">
                                    <Label FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Numero, StringFormat='{0}. '}" />
                                                <Span Text="{Binding Texto}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Picker Title="Selecciona una respuesta" SelectedIndex="{Binding Respuesta}">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Ningún día</x:String>
                                                <x:String>Varios días</x:String>
                                                <x:String>Más de la mitad de los días</x:String>
                                                <x:String>Casi todos los días</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ===================== Paso 2: IPAQ ===================== -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding EnPasoIpaq}">
                    <Label Text="Piensa en los últimos 7 días." FontSize="12" TextColor="Gray" />

                    <Label Text="Actividad física VIGOROSA (ej. correr, aeróbicos)" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Días por semana" FontSize="12" />
                            <Entry Keyboard="Numeric" Text="{Binding IpaqVigorosoDias}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Minutos por día" FontSize="12" />
                            <Entry Keyboard="Numeric" Text="{Binding IpaqVigorosoMinutos}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Actividad física MODERADA (ej. bicicleta suave)" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Días por semana" FontSize="12" />
                            <Entry Keyboard="Numeric" Text="{Binding IpaqModeradoDias}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Minutos por día" FontSize="12" />
                            <Entry Keyboard="Numeric" Text="{Binding IpaqModeradoMinutos}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="CAMINATA (10 minutos o más seguidos)" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Días por semana" FontSize="12" />
                            <Entry Keyboard="Numeric" Text="{Binding IpaqCaminataDias}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Minutos por día" FontSize="12" />
                            <Entry Keyboard="Numeric" Text="{Binding IpaqCaminataMinutos}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- ===================== Paso 3: SISCO SV-21 ===================== -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding EnPasoSisco}">
                    <Label Text="Durante el transcurso de este semestre, ¿has tenido momentos de preocupación o nerviosismo (estrés)?" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding OpcionesSiNo}" SelectedItem="{Binding RespuestaFiltroSisco}" />

                    <VerticalStackLayout Spacing="16" IsVisible="{Binding MostrarPreguntasSisco}">

                        <Label Text="Estresores" Style="{StaticResource SubHeadline}" FontSize="18" />
                        <Label Text="¿Con qué frecuencia te estresa cada uno de estos aspectos?" FontSize="12" />
                        <CollectionView ItemsSource="{Binding PreguntasEstresores}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="items:PreguntaSiscoItem">
                                    <VerticalStackLayout Spacing="4" Margin="0,8">
                                        <Label Text="{Binding Texto}" FontAttributes="Bold" />
                                        <Picker Title="Selecciona una frecuencia" SelectedIndex="{Binding Respuesta}">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Nunca</x:String>
                                                    <x:String>Casi nunca</x:String>
                                                    <x:String>Rara vez</x:String>
                                                    <x:String>Algunas veces</x:String>
                                                    <x:String>Casi siempre</x:String>
                                                    <x:String>Siempre</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="Síntomas" Style="{StaticResource SubHeadline}" FontSize="18" />
                        <Label Text="¿Con qué frecuencia se te presentan estas reacciones cuando estás estresado(a)?" FontSize="12" />
                        <CollectionView ItemsSource="{Binding PreguntasSintomas}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="items:PreguntaSiscoItem">
                                    <VerticalStackLayout Spacing="4" Margin="0,8">
                                        <Label Text="{Binding Texto}" FontAttributes="Bold" />
                                        <Picker Title="Selecciona una frecuencia" SelectedIndex="{Binding Respuesta}">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Nunca</x:String>
                                                    <x:String>Casi nunca</x:String>
                                                    <x:String>Rara vez</x:String>
                                                    <x:String>Algunas veces</x:String>
                                                    <x:String>Casi siempre</x:String>
                                                    <x:String>Siempre</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="Estrategias de afrontamiento" Style="{StaticResource SubHeadline}" FontSize="18" />
                        <Label Text="¿Con qué frecuencia utilizas cada una de estas acciones para enfrentar tu estrés?" FontSize="12" />
                        <CollectionView ItemsSource="{Binding PreguntasEstrategias}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="items:PreguntaSiscoItem">
                                    <VerticalStackLayout Spacing="4" Margin="0,8">
                                        <Label Text="{Binding Texto}" FontAttributes="Bold" />
                                        <Picker Title="Selecciona una frecuencia" SelectedIndex="{Binding Respuesta}">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Nunca</x:String>
                                                    <x:String>Casi nunca</x:String>
                                                    <x:String>Rara vez</x:String>
                                                    <x:String>Algunas veces</x:String>
                                                    <x:String>Casi siempre</x:String>
                                                    <x:String>Siempre</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===================== Paso 4: Revisión ===================== -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding EnPasoRevision}">
                    <Label Text="Revisa antes de enviar" Style="{StaticResource SubHeadline}" FontSize="18" />
                    <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Primary}" Padding="16">
                        <Label Text="{Binding ResumenPrevio}" LineBreakMode="WordWrap" />
                    </Border>
                    <Label Text="Una vez enviada, no vas a poder modificar esta fase — revisa que hayas respondido con calma." FontSize="12" TextColor="Gray" />
                    <Button Text="Enviar encuesta" Command="{Binding EnviarCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===================== Navegación ===================== -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12"
              IsVisible="{Binding MostrarAsistente}">
            <Button Grid.Column="0" Text="Atrás" Command="{Binding AnteriorCommand}"
                    IsVisible="{Binding MostrarAnterior}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
            <Button Grid.Column="1" Text="Siguiente" Command="{Binding SiguienteCommand}"
                    IsVisible="{Binding EnPasoRevision, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

    </Grid>

</ContentPage>
