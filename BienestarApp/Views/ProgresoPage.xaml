<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             xmlns:items="clr-namespace:BienestarApp.ViewModels.Items"
             x:Class="BienestarApp.Views.ProgresoPage"
             x:DataType="viewmodels:ProgresoViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding MensajeError}"
                   TextColor="Red"
                   IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Racha + promedio: lo que hace que volver todos los días valga la pena. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding SinDatos, Converter={StaticResource InvertedBoolConverter}}">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="16"
                        Stroke="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AcentoFondo}, Dark={StaticResource AcentoFondoOscuro}}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding RachaDias, StringFormat='{0} 🔥'}" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="días seguidos" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Primary}" Padding="16">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding PromedioEstres, StringFormat='{0}/10'}" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="estrés promedio" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Sin check-ins todavía en los últimos 7 días." IsVisible="{Binding SinDatos}" HorizontalOptions="Center" />

            <!-- Gráfico semanal: se dibuja en ProgresoPage.xaml.cs (GraficoSemanalDrawable). -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding SinDatos, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Tu semana" Style="{StaticResource SubHeadline}" FontSize="18" />
                <GraphicsView x:Name="GraficoSemanal" HeightRequest="170" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="18">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Acento}" VerticalOptions="Center" />
                        <Label Text="Estrés" FontSize="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                                 Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Ánimo" FontSize="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Logros: se ganan por constancia (ver CalculadorLogros). Los
                 bloqueados se ven tenues y en gris. -->
            <Label Text="Mis logros" Style="{StaticResource SubHeadline}" FontSize="18" />
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceEvenly" BindableLayout.ItemsSource="{Binding Logros}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="items:LogroItem">
                        <Border WidthRequest="96" Margin="4" Padding="8,10"
                                StrokeShape="RoundRectangle 12" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                BackgroundColor="Transparent" Opacity="0.4">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Desbloqueado}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AcentoFondo}, Dark={StaticResource AcentoFondoOscuro}}" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Emoji}" FontSize="26" HorizontalOptions="Center" />
                                <Label Text="{Binding Titulo}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Descripcion}" FontSize="10" HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="Nivel de estrés por día" Style="{StaticResource SubHeadline}" FontSize="18" IsVisible="{Binding SinDatos, Converter={StaticResource InvertedBoolConverter}}" />
            <Label Text="1 = muy bajo · 10 = muy alto" FontSize="12" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                   IsVisible="{Binding SinDatos, Converter={StaticResource InvertedBoolConverter}}" />

            <CollectionView ItemsSource="{Binding Dias}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:DiaProgresoItem">
                        <VerticalStackLayout Spacing="6" Margin="0,8">
                            <!-- Fecha | barra (fondo de 0 a 10 + parte llena) | valor -->
                            <Grid ColumnDefinitions="72,*,48" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="{Binding FechaTexto}" FontSize="13" VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        HeightRequest="14"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 7"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                        VerticalOptions="Center">
                                    <AbsoluteLayout>
                                        <Border AbsoluteLayout.LayoutFlags="All"
                                                AbsoluteLayout.LayoutBounds="{Binding LimitesBarraEstres}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 7"
                                                BackgroundColor="{Binding ColorBarraEstres}" />
                                    </AbsoluteLayout>
                                </Border>
                                <Label Grid.Column="2" Text="{Binding EstresTexto}" FontSize="13" FontAttributes="Bold"
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding DetalleTexto}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Volver" Command="{Binding VolverCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
