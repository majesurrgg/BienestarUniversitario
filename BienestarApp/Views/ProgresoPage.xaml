<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             xmlns:items="clr-namespace:BienestarApp.ViewModels.Items"
             x:Class="BienestarApp.Views.ProgresoPage"
             x:DataType="viewmodels:ProgresoViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding MensajeError}"
                   TextColor="Red"
                   IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Racha + promedio: lo que hace que volver todos los días valga la pena. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding SinDatos, Converter={StaticResource InvertedBoolConverter}}">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Primary}" Padding="16">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding RachaDias, StringFormat='{0} 🔥'}" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="días seguidos" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Primary}" Padding="16">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding PromedioEstres, StringFormat='{0}/10'}" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="estrés promedio" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Sin check-ins todavía en los últimos 7 días." IsVisible="{Binding SinDatos}" HorizontalOptions="Center" />

            <Label Text="Nivel de estrés por día" Style="{StaticResource SubHeadline}" FontSize="18" IsVisible="{Binding SinDatos, Converter={StaticResource InvertedBoolConverter}}" />

            <CollectionView ItemsSource="{Binding Dias}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:DiaProgresoItem">
                        <VerticalStackLayout Spacing="4" Margin="0,6">
                            <Grid ColumnDefinitions="70,*">
                                <Label Grid.Column="0" Text="{Binding FechaTexto}" FontSize="12" VerticalOptions="Center" />
                                <BoxView Grid.Column="1" HeightRequest="16" CornerRadius="4"
                                         Color="{Binding ColorBarraEstres}"
                                         WidthRequest="{Binding AnchoBarraEstres}"
                                         HorizontalOptions="Start" />
                            </Grid>
                            <Label FontSize="11" TextColor="Gray">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CalidadSueno, StringFormat='Sueño: {0}/5 · '}" />
                                        <Span Text="{Binding EstadoAnimo, StringFormat='Ánimo: {0}/5 · '}" />
                                        <Span Text="{Binding MinutosActividadFisica, StringFormat='Actividad: {0} min'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Volver" Command="{Binding VolverCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
