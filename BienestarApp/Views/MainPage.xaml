<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             x:Class="BienestarApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="20">

            <Image Source="logo_bienestar.svg" HeightRequest="56" WidthRequest="56" HorizontalOptions="Center" />
            <Label
                Text="{Binding Title}"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Subtitulo}" Style="{StaticResource SubHeadline}" FontSize="14" />

            <!-- Paso 1, obligatorio: encuesta basal. Se muestra como el
                 paso activo mientras no esté completada, y bloquea el
                 check-in — no tiene sentido medir el día a día sin la
                 línea base. -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Primary}"
                    BackgroundColor="{AppThemeBinding Light=#EAF3F2, Dark=#1C2023}"
                    Padding="18"
                    IsVisible="{Binding PuedeHacerCheckIn, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Paso 1 de 2 · Encuesta basal" FontAttributes="Bold" />
                    <Label Text="Antes de empezar tu registro diario, completa una sola vez la encuesta inicial (PHQ-9, IPAQ y SISCO). Es la línea base con la que se compara tu progreso." FontSize="13" />
                    <Button Text="Completar encuesta basal" Command="{Binding IrAEncuestaBasalCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Paso 2: check-in diario, habilitado solo tras la basal. -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding PuedeHacerCheckIn}">

                <!-- Vista previa de la racha: le da al estudiante una razón
                     para abrir la app además de "tengo que llenar algo". -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Primary}" Padding="14"
                        IsVisible="{Binding YaHizoCheckInHoy, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="{Binding RachaDias, StringFormat='🔥 Llevas {0} días seguidos. ¡No cortes la racha hoy!'}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="13" />
                </Border>
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Primary}" Padding="14"
                        IsVisible="{Binding YaHizoCheckInHoy}">
                    <Label Text="✔ Ya registraste tu día de hoy." HorizontalOptions="Center" FontSize="13" />
                </Border>

                <Button Text="Registrar mi día" Command="{Binding IrACheckInCommand}" />
                <Button Text="Mi progreso" Command="{Binding IrAProgresoCommand}" />
                <Button Text="Encuesta basal" Command="{Binding IrAEncuestaBasalCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

            <Button Text="Cerrar sesión" Command="{Binding CerrarSesionCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
