<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             x:Class="BienestarApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="20">

            <Label
                Text="{Binding Title}"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <!-- Paso 1, obligatorio: encuesta basal. Se muestra como el
                 paso activo mientras no esté completada, y bloquea el
                 check-in — no tiene sentido medir el día a día sin la
                 línea base. -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Primary}"
                    BackgroundColor="{AppThemeBinding Light=#EAF3F2, Dark=#1C2023}"
                    Padding="18"
                    IsVisible="{Binding PuedeHacerCheckIn, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Paso 1 de 2 · Encuesta basal" FontAttributes="Bold" />
                    <Label Text="Antes de empezar tu registro diario, completa una sola vez la encuesta inicial (PHQ-9, IPAQ y SISCO). Es la línea base con la que se compara tu progreso." FontSize="13" />
                    <Button Text="Completar encuesta basal" Command="{Binding IrAEncuestaBasalCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Paso 2: check-in diario, habilitado solo tras la basal. -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding PuedeHacerCheckIn}">
                <Label
                    Text="{Binding EstadoSesion}"
                    Style="{StaticResource SubHeadline}"
                    FontSize="14"
                    SemanticProperties.HeadingLevel="Level2" />

                <Button Text="Registrar mi día" Command="{Binding IrACheckInCommand}" />
                <Button Text="Encuesta basal" Command="{Binding IrAEncuestaBasalCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

            <!-- Diagnóstico del recordatorio (Sprint 4, quitar cuando esté
                 validado): confirma en pantalla si quedó programado, sin
                 depender de esperar a que suene. -->
            <Label Text="{Binding EstadoRecordatorio}" FontSize="11" TextColor="Gray" />

            <Button Text="Cerrar sesión" Command="{Binding CerrarSesionCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
