<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BienestarApp.ViewModels"
             xmlns:items="clr-namespace:BienestarApp.ViewModels.Items"
             x:Class="BienestarApp.Views.CheckInPage"
             x:DataType="viewmodels:CheckInViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16">

            <Label Text="¿Cómo estuvo tu día?" Style="{StaticResource Headline}" HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Formulario: solo si todavía no registró el día de hoy -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding MostrarFormulario}">

                <Label Text="{Binding NivelEstres, StringFormat='Nivel de estrés: {0:F0} / 10'}" FontAttributes="Bold" />
                <Slider Minimum="1" Maximum="10" Value="{Binding NivelEstres}" />
                <Grid ColumnDefinitions="*,*">
                    <Label Text="1 = muy bajo" FontSize="12" />
                    <Label Grid.Column="1" Text="10 = muy alto" FontSize="12" HorizontalOptions="End" />
                </Grid>

                <Label Text="{Binding CalidadSueno, StringFormat='Calidad de sueño: {0:F0} / 5'}" FontAttributes="Bold" />
                <Slider Minimum="1" Maximum="5" Value="{Binding CalidadSueno}" />
                <Label Text="{Binding DescripcionSueno}" FontSize="12" HorizontalOptions="Center" />

                <!-- Ánimo con caritas (1 a 5): se toca una en vez de arrastrar
                     un deslizador. La elegida se marca en rosa (Acento). -->
                <Label Text="¿Cómo estuvo tu ánimo?" FontAttributes="Bold" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" BindableLayout.ItemsSource="{Binding OpcionesAnimo}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="items:OpcionAnimoItem">
                            <Border WidthRequest="54" HeightRequest="54"
                                    StrokeShape="RoundRectangle 27" StrokeThickness="2"
                                    Stroke="Transparent" BackgroundColor="Transparent" Opacity="0.5"
                                    SemanticProperties.Description="{Binding Etiqueta}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Seleccionado}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AcentoFondo}, Dark={StaticResource AcentoFondoOscuro}}" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SeleccionarCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Emoji}" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
                <Label Text="{Binding DescripcionAnimo}" FontSize="12" HorizontalOptions="Center" />

                <Label Text="{Binding MinutosActividadFisica, StringFormat='Actividad física: {0:F0} minutos'}" FontAttributes="Bold" />
                <Stepper Minimum="0" Maximum="600" Increment="10" Value="{Binding MinutosActividadFisica}" HorizontalOptions="Center" />

                <Label Text="{Binding MensajeError}"
                       TextColor="Red"
                       IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

                <Button Text="Guardar mi día" Command="{Binding GuardarCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Resumen: si ya registró hoy -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding YaRegistroHoy}">
                <!-- El corazón "late" justo después de guardar (ver CheckInPage.xaml.cs). -->
                <Image x:Name="CorazonCelebracion" Source="logo_bienestar.svg"
                       HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" />
                <Label Text="✔ Ya registraste tu día de hoy" Style="{StaticResource SubHeadline}" HorizontalOptions="Center" />
                <Label Text="{Binding ResumenHoy}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="Vuelve mañana para tu siguiente registro." FontSize="12" HorizontalOptions="Center" />

                <!-- Sugerencia amable si el estrés de hoy salió alto (7 o más). -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,8,0,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AcentoFondo}, Dark={StaticResource AcentoFondoOscuro}}"
                        IsVisible="{Binding EstresAltoHoy}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Hoy tu estrés está alto. ¿Te tomas un minuto para respirar?"
                               FontSize="14" HorizontalTextAlignment="Center" />
                        <Button Text="🌬️ Respira 1 minuto" Command="{Binding IrARespiracionCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
